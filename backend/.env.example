PORT=4000
CORS_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Leave empty when using the default XAMPP/MariaDB root account with no password.
DB_PASSWORD=
DB_NAME=dental_care_center
# Optional when the frontend and API are on different hosts.
# PUBLIC_API_URL=http://localhost:4000

# Server-verified Admin login. Change these before entering real patient information.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dental@123
# Use a long, random value and keep it private.
SESSION_SECRET=replace-this-with-a-long-random-secret-before-deployment
